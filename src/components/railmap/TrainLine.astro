---
export const SYDNEY_TRAINS_T9_TAILWIND = "border-[#D72F36]"

export interface Props {
  /**
   * trainLine is the Tailwind/CSS classes for the train-line symbol in the logo.
   *
   * Please set border colour instead of background colour to keep navigation bar functional.
   *
   * @default SYDNEY_TRAINS_T9_TAILWIND
   */
  trainLine?: string
  /**
   * trainLineWidth controls how thick is the train-line symbol in the logo.
   * @default "10px"
   */
  trainLineWidth?: string
}

export const defaults: Required<Props> = {
  trainLine: SYDNEY_TRAINS_T9_TAILWIND,
  trainLineWidth: "10px",
}

const { trainLine, trainLineWidth, } = { ...defaults, ...Astro.props };

---
<div class={`train-line ${trainLine} grow self-stretch col-start-2`} />

<style define:vars={{ "train-line-width": trainLineWidth }} >
  .train-line {
    border-bottom-width: var(--train-line-width);
  }
</style>

