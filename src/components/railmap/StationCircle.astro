---
import { type CommonProps, type Default } from '../../utils/props';
import { defaults as lineDefaults, type Props as TrainLineProps } from './TrainLine.astro';

export type Direction = "x" | "y"

export interface AlignmentProps {
  /**
   * trainLineWidth is needed to align the station circle with an underlying train line.
   */
  trainLineWidth: string
  /**
   * alignDirection is needed to align the station circle with an underlying train line.
   */
  alignDirection: Direction
}

export interface Props extends CommonProps, AlignmentProps {
  /**
   * colourClass contains class names that controls the colour of the component.
   * @default `
   *   [&>.circle-front]:border-(--colour) [&>.circle-front]:bg-white
   *   [&>.circle-front]:group-hover:border-(--hover-colour)
   *   [&>.circle-front]:group-focus:border-(--hover-colour)
   * `
   */
  colourClass?: string
  /**
   * colour defines --colour the CSS variable for the component.
   * @default "var(--sydney-trains-t9)"
   */
  colour?: string
  /**
   * sizeClass contains class names that controls the size of the component.
   * @default "[&>.circle-front]:border-4 [&>.circle-front]:w-5 [&>.interchange-shade]:w-7"
   */
  sizeClass?: string

  /**
   * hover enables hover effects.
   * @default false
   */
  hover?: boolean
  /**
   * hover defines --hover-colour the CSS variable for the component and will be used when hover
   *       effects are enabled.
   * @default "var(--sydney-trains-t1)"
   */
  hoverColour?: string
}

export const defaults: Default<Props> = {
  colourClass: `
  [&>.circle-front]:border-(--colour) [&>.circle-front]:bg-white
  [&>.circle-front]:group-hover:border-(--hover-colour)
  [&>.circle-front]:group-focus:border-(--hover-colour)
  `,
  colour: "var(--sydney-trains-t9)",
  sizeClass: "[&>.circle-front]:border-4 [&>.circle-front]:w-5 [&>.interchange-shade]:w-7",
  hover: false,
  hoverColour: "var(--sydney-trains-t1)",
}

export function alignByTrainLine(lineProps: TrainLineProps) : AlignmentProps {
  const linePropsAll: Required<TrainLineProps> = { class: "", ...lineDefaults, ...lineProps }
  const { width, left, right } = linePropsAll
  return {
    trainLineWidth: width,
    // Alignment prioritises the X axis:
    alignDirection: (left || right) ? "x" : "y" // TODO: translation plus or minus
  }
}

const {
  class: c,
  colourClass,
  colour,
  sizeClass,
  hover,
  hoverColour,
  trainLineWidth,
  alignDirection,
} = { ...defaults, ...Astro.props };
const alignX = alignDirection === "x" ? 1 : 0
const alignY = alignDirection === "y" ? 1 : 0

---
<div class:list={[`self ${c} ${colourClass} ${sizeClass} absolute grid place-items-center`, { "align-x": alignX, "align-y": alignY }]}>
  {hover && <div class={`
    interchange-shade absolute interchange-shade rounded-full bg-[rgba(0,0,0,0.25)] aspect-square scale-0
    transition-transform duration-100 row-start-1 col-start-1 z-10
    group-hover:scale-100
    group-focus:scale-100
    `} />}
  <div class="circle-front rounded-full aspect-square transition-colors duration-150 row-start-1 col-start-1 z-20" />
</div>

<style define:vars={{ "train-line-width": trainLineWidth, "colour": colour, "hover-colour": hoverColour }} >
  .self {
    --translation: calc(-50% + var(--train-line-width) / 2);
  }
  .align-x {
    transform: translateX(var(--translation));
  }
  .align-y {
    transform: translateY(var(--translation)) translateX(-25%);
  }
</style>

