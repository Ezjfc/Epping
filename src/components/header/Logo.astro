---

export const SYDNEY_TRAINS_T9_TAILWIND = "border-[#D72F36]"

export interface Props {
  /**
   * trainLine is the Tailwind/CSS classes for the train-line symbol in the logo.
   *
   * Please set border colour instead of background colour to keep navigation bar functional.
   *
   * @default SYDNEY_TRAINS_T9_TAILWIND + ""
   */
  trainLine?: string
  /**
   * trainLineWidth controls how thick is the train-line symbol in the logo.
   * @default "10px"
   */
  trainLineWidth?: string
  /**
   * stationCircle is the Tailwind/CSS classes for the station-circle symbol in the logo.
   *
   * @default "border-black"
   */
  stationCircle?: string
}

export const defaults: Required<Props> = {
  trainLine: SYDNEY_TRAINS_T9_TAILWIND,
  trainLineWidth: "10px",
  stationCircle: "border-black",
}

const { trainLine, trainLineWidth, stationCircle } = { ...defaults, ...Astro.props };

---
<style define:vars={{ "train-line-width": trainLineWidth }} >
  .train-line {
    border-left-width: calc(var(--train-line-width));
    border-bottom-width: calc(var(--train-line-width));
  }
  .station-circle {
    transform: translateX(calc(-50% - var(--train-line-width) / 2));
  }
</style>

<div class={`train-line ${trainLine} h-20 rounded-bl-4xl flex items-center justify-start group`}>
  <div class={`
    station-circle ${stationCircle} absolute rounded-full bg-white border-4 w-5 aspect-square
    -translate-y-1
  `} />

  <div class="ml-2" >
    <h5 class="font-bold" >
      <slot />
    </h5>
  </div>
</div>

