---

export const SYDNEY_TRAINS_T9_TAILWIND = "border-[#D72F36]"

interface Props {
  /**
   * trainLine is the Tailwind/CSS classes for the train-line symbol in the logo.
   *
   * Please set border colour instead of background colour to keep navigation bar functional.
   *
   * @default SYDNEY_TRAINS_T9_TAILWIND
   */
  trainLine?: string
  /**
   * trainLineWidth controls how many pixels thick is the train-line symbol in the logo.
   * @default 12
   */
  trainLineWidth?: number
  /**
   * stationCircle is the Tailwind/CSS classes for the station-circle symbol in the logo.
   *
   * @default "border-black"
   */
  stationCircle?: string
}

const defaults: Required<Props> = {
  trainLine: SYDNEY_TRAINS_T9_TAILWIND,
  trainLineWidth: 12,
  stationCircle: "border-black",
}

const { trainLine, trainLineWidth, stationCircle } = { ...defaults, ...Astro.props };

import { SITE_TITLE } from '../../consts';

---
<div class={`${trainLine} border-l-${trainLineWidth} border-b-${trainLineWidth} h-20 rounded-bl-4xl flex items-center justify-start`}>
  <div class={`
    absolute
    rounded-full bg-white ${stationCircle} border-4 w-5 aspect-square
    -translate-x-[calc(50%+6px)] -translate-y-1
  `} />

  <div class="ml-2" >
    <h5 class="font-bold" >
    {SITE_TITLE}
    </h5>
  </div>
</div>

