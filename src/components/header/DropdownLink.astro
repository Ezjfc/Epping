---
import type { HTMLAttributes } from 'astro/types';
import type { AlignmentProps as CircleAlignmentProps } from '../railmap/StationCircle.astro';
import StationCircle from '../railmap/StationCircle.astro';

interface Props extends HTMLAttributes<'a'>, CircleAlignmentProps {
  /**
   * label is the text to display.
   */
  label: string
}

const { href, class: className, label, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
// const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
const isActive = false
---

<a href={href} data-text={label} class:list={[className, { active: isActive }]} {...props}>
  <!-- <StationCircle {...props} /> -->
  {label}
</a>
<style>
  a {
    display: block;
    margin: 0px 0px;
    padding-left: 20px;
  }
  a.active {
    font-weight: 700;
    /* text-decoration: underline; */
  }

  a::after, a.active::after {
    content: attr(data-text);
    display: block;
    font-weight: 700;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }
</style>
