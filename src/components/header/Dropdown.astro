---
import { getProps, type CommonProps } from '../../utils/props'
import { type Default } from '../../utils/props'
import TrainLine from '../railmap/TrainLine.astro'

export interface Props extends CommonProps {
}

const defaults: Default<Props> = {
}
const { class: c } = getProps(Astro.props, defaults)

---
<div class={`${c} grid grid-cols-[max-content_1fr]`}>
  <TrainLine left class="train-line h-full" colour="var(--sydney-trains-t1)" /><!-- m1 requires stripe design try to figure out later on -->
  <div class="dropdown-links flex flex-col" >
    <div class="spacer h-[calc(1em*var(--line-height))]" />
    <slot/>
  </div>
</div>
